[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "open", "path": "${PROJ}/src/scratch.lisp"},
  {"op": "wait", "what": "index"},

  {"op": "log", "value": "auto-pairing, overtyping and smart Enter"},
  {"op": "text", "value": "(defun foo (x)"},
  {"op": "assert_text", "value": "(defun foo (x))"},
  {"op": "key", "value": "Enter"},
  {"op": "assert_text", "value": "(defun foo (x)\\n  )"},
  {"op": "assert_caret", "line": 2, "col": 3},
  {"op": "text", "value": "(+ x 1"},
  {"op": "assert_text", "value": "(defun foo (x)\\n  (+ x 1))"},
  {"op": "assert_modified", "value": true},

  {"op": "log", "value": "strings pair and escape"},
  {"op": "key", "value": "Ctrl+End"},
  {"op": "key", "value": "Enter"},
  {"op": "text", "value": "\"hi"},
  {"op": "assert_text_contains", "value": "\"hi\""},

  {"op": "log", "value": "undo / redo"},
  {"op": "key", "value": "Ctrl+Z"},
  {"op": "assert_modified", "value": true},
  {"op": "key", "value": "Ctrl+Shift+Z"},
  {"op": "assert_text_contains", "value": "\"hi\""},

  {"op": "log", "value": "backspace removes an empty pair"},
  {"op": "set_text", "value": ""},
  {"op": "text", "value": "("},
  {"op": "assert_text", "value": "()"},
  {"op": "key", "value": "Backspace"},
  {"op": "assert_text", "value": ""},

  {"op": "log", "value": "line commands"},
  {"op": "set_text", "value": "one\\ntwo\\nthree"},
  {"op": "caret", "line": 2, "col": 2},
  {"op": "key", "value": "Ctrl+D"},
  {"op": "assert_text", "value": "one\\ntwo\\ntwo\\nthree"},
  {"op": "key", "value": "Ctrl+Y"},
  {"op": "assert_text", "value": "one\\ntwo\\nthree"},
  {"op": "caret", "line": 2, "col": 2},
  {"op": "key", "value": "Alt+Shift+Up"},
  {"op": "assert_text", "value": "two\\none\\nthree"},
  {"op": "key", "value": "Ctrl+Slash"},
  {"op": "assert_text", "value": ";; two\\none\\nthree"},
  {"op": "key", "value": "Ctrl+Slash"},
  {"op": "assert_text", "value": "two\\none\\nthree"},

  {"op": "log", "value": "selection: extend with Ctrl+W, select all, word movement"},
  {"op": "set_text", "value": "(foo (bar baz) qux)"},
  {"op": "caret", "line": 1, "col": 8},
  {"op": "key", "value": "Ctrl+W"},
  {"op": "assert_selection", "value": "bar"},
  {"op": "key", "value": "Ctrl+W"},
  {"op": "assert_selection", "value": "bar baz"},
  {"op": "key", "value": "Ctrl+Shift+W"},
  {"op": "assert_selection", "value": "bar"},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "assert_selection", "value": "(foo (bar baz) qux)"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}.png"},
  {"op": "quit"}
]
