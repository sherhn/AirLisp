[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "open", "path": "${PROJ}/src/messy.lisp"},
  {"op": "wait", "what": "index"},

  {"op": "log", "value": "Find Action: run a command by name"},
  {"op": "key", "value": "Ctrl+Shift+A"},
  {"op": "assert_popup", "value": "palette"},
  {"op": "text", "value": "reformat"},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_actions.png"},
  {"op": "key", "value": "Enter"},
  {"op": "assert_popup", "value": "none"},
  {"op": "assert_text", "value": "(defun f (x)\\n  (let ((a 1)\\n        (b 2))\\n    (+ a b x)))\\n"},

  {"op": "log", "value": "Search Everywhere via double Shift"},
  {"op": "mods", "value": "Shift"},
  {"op": "mods", "value": ""},
  {"op": "mods", "value": "Shift"},
  {"op": "mods", "value": ""},
  {"op": "assert_popup", "value": "palette"},
  {"op": "text", "value": "nav"},
  {"op": "frames", "value": 30},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_everywhere.png"},
  {"op": "key", "value": "Escape"},
  {"op": "assert_popup", "value": "none"},

  {"op": "log", "value": "Go to File"},
  {"op": "key", "value": "Ctrl+Shift+N"},
  {"op": "text", "value": "navl"},
  {"op": "frames", "value": 3},
  {"op": "key", "value": "Enter"},
  {"op": "assert_active_file", "value": "nav.lisp"},
  {"op": "assert_tabs", "value": 2},

  {"op": "log", "value": "Go to Symbol"},
  {"op": "key", "value": "Ctrl+Alt+Shift+N"},
  {"op": "text", "value": "beta"},
  {"op": "frames", "value": 3},
  {"op": "key", "value": "Enter"},
  {"op": "assert_caret", "line": 4, "col": 8},

  {"op": "log", "value": "Go to Line"},
  {"op": "key", "value": "Ctrl+G"},
  {"op": "assert_popup", "value": "goto_line"},
  {"op": "text", "value": "2:4"},
  {"op": "key", "value": "Enter"},
  {"op": "assert_caret", "line": 2, "col": 4},

  {"op": "log", "value": "Recent files and structure popup"},
  {"op": "key", "value": "Ctrl+E"},
  {"op": "assert_popup", "value": "palette"},
  {"op": "key", "value": "Escape"},
  {"op": "key", "value": "Ctrl+F12"},
  {"op": "assert_popup", "value": "palette"},
  {"op": "text", "value": "alpha"},
  {"op": "frames", "value": 3},
  {"op": "key", "value": "Enter"},
  {"op": "assert_caret", "line": 1, "col": 8},
  {"op": "quit"}
]
