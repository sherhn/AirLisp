[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "open", "path": "${PROJ}/src/main.lisp"},
  {"op": "wait", "what": "index"},
  {"op": "log", "value": "start the REPL from the tool window"},
  {"op": "command", "value": "view.repl"},
  {"op": "assert_bottom", "value": "repl"},
  {"op": "wait", "what": "repl_ready", "timeout": 90},

  {"op": "log", "value": "Ctrl+Enter sends the top-level form under the caret"},
  {"op": "focus_editor"},
  {"op": "caret", "line": 4, "col": 4},
  {"op": "key", "value": "Ctrl+Enter"},
  {"op": "wait", "what": "idle", "timeout": 30},
  {"op": "assert_repl_contains", "value": "GREET"},
  {"op": "caret", "line": 8, "col": 4},
  {"op": "key", "value": "Ctrl+Enter"},
  {"op": "wait", "what": "idle", "timeout": 30},
  {"op": "assert_repl_contains", "value": "MAIN"},

  {"op": "log", "value": "type into the REPL input and press Enter"},
  {"op": "command", "value": "repl.focus"},
  {"op": "frames", "value": 3},
  {"op": "text", "value": "(greet \"Lisp\")"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "idle", "timeout": 30},
  {"op": "assert_repl_contains", "value": "Hello, Lisp!"},

  {"op": "text", "value": "(main)"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "idle", "timeout": 30},
  {"op": "assert_repl_contains", "value": "Hello, world!"},

  {"op": "log", "value": "incomplete input does not submit on Enter"},
  {"op": "text", "value": "(+ 1"},
  {"op": "key", "value": "Enter"},
  {"op": "frames", "value": 3},
  {"op": "text", "value": " 2)"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "idle", "timeout": 30},
  {"op": "assert_repl_contains", "value": "3"},

  {"op": "log", "value": "errors are reported and the REPL survives"},
  {"op": "text", "value": "(/ 1 0)"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "idle", "timeout": 30},
  {"op": "assert_repl_contains", "value": "DIVISION-BY-ZERO"},
  {"op": "text", "value": "(+ 40 2)"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "idle", "timeout": 30},
  {"op": "assert_repl_contains", "value": "42"},

  {"op": "log", "value": "unicode"},
  {"op": "text", "value": "(princ \"Привет, мир\")"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "idle", "timeout": 30},
  {"op": "assert_repl_contains", "value": "Привет, мир"},

  {"op": "log", "value": "load file into the REPL"},
  {"op": "focus_editor"},
  {"op": "key", "value": "Ctrl+Shift+L"},
  {"op": "wait", "what": "idle", "timeout": 30},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}.png"},
  {"op": "command", "value": "repl.restart"},
  {"op": "wait", "what": "repl_ready", "timeout": 90},
  {"op": "quit"}
]
