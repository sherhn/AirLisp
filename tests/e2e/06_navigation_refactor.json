[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "open", "path": "${PROJ}/src/nav.lisp"},
  {"op": "wait", "what": "index"},

  {"op": "log", "value": "Go to Declaration (Ctrl+B) and Back (Ctrl+Alt+Left)"},
  {"op": "caret", "line": 5, "col": 6},
  {"op": "key", "value": "Ctrl+B"},
  {"op": "assert_caret", "line": 1, "col": 8},
  {"op": "key", "value": "Ctrl+Alt+Left"},
  {"op": "assert_caret", "line": 5, "col": 6},
  {"op": "key", "value": "Ctrl+Alt+Right"},
  {"op": "assert_caret", "line": 1, "col": 8},

  {"op": "log", "value": "Find Usages (Alt+F7)"},
  {"op": "key", "value": "Alt+F7"},
  {"op": "assert_find_results", "min": 2},
  {"op": "assert_bottom", "value": "find"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_usages.png"},

  {"op": "log", "value": "Rename (Shift+F6)"},
  {"op": "focus_editor"},
  {"op": "caret", "line": 1, "col": 9},
  {"op": "key", "value": "Shift+F6"},
  {"op": "assert_popup", "value": "rename"},
  {"op": "frames", "value": 2},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "text", "value": "gamma"},
  {"op": "key", "value": "Enter"},
  {"op": "assert_popup", "value": "none"},
  {"op": "assert_text", "value": "(defun gamma (x)\\n  (* x 2))\\n\\n(defun beta (y)\\n  (gamma y))\\n"},

  {"op": "log", "value": "Find in Files"},
  {"op": "key", "value": "Ctrl+Shift+F"},
  {"op": "assert_popup", "value": "find_in_files"},
  {"op": "text", "value": "gamma"},
  {"op": "key", "value": "Enter"},
  {"op": "assert_find_results", "min": 2},

  {"op": "log", "value": "Quick documentation"},
  {"op": "focus_editor"},
  {"op": "caret", "line": 5, "col": 6},
  {"op": "key", "value": "Ctrl+Q"},
  {"op": "assert_popup", "value": "info"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_doc.png"},
  {"op": "key", "value": "Escape"},
  {"op": "assert_popup", "value": "none"},
  {"op": "quit"}
]
