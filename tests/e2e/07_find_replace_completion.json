[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "open", "path": "${PROJ}/src/scratch.lisp"},
  {"op": "wait", "what": "index"},

  {"op": "log", "value": "Find bar: Ctrl+F, count, F3 stepping, Escape"},
  {"op": "set_text", "value": "foo bar foo\\nFoo"},
  {"op": "key", "value": "Ctrl+F"},
  {"op": "frames", "value": 3},
  {"op": "text", "value": "foo"},
  {"op": "frames", "value": 2},
  {"op": "assert_find", "matches": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_find.png"},
  {"op": "key", "value": "Enter"},
  {"op": "assert_selection", "value": "foo"},
  {"op": "key", "value": "Escape"},
  {"op": "frames", "value": 2},
  {"op": "focus_editor"},
  {"op": "key", "value": "F3"},
  {"op": "assert_selection", "value": "foo"},

  {"op": "log", "value": "completion popup: static vocabulary, accept with Tab"},
  {"op": "key", "value": "Escape"},
  {"op": "set_text", "value": ""},
  {"op": "focus_editor"},
  {"op": "text", "value": "(defu"},
  {"op": "assert_completion", "value": "defun"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_completion.png"},
  {"op": "key", "value": "Tab"},
  {"op": "assert_text", "value": "(defun)"},
  {"op": "assert_no_completion"},

  {"op": "log", "value": "completion from project definitions"},
  {"op": "set_text", "value": ""},
  {"op": "focus_editor"},
  {"op": "text", "value": "(gree"},
  {"op": "assert_text", "value": "(gree)"},
  {"op": "assert_completion", "value": "greet"},
  {"op": "key", "value": "Escape"},
  {"op": "assert_no_completion"},

  {"op": "log", "value": "Ctrl+Space opens completion explicitly"},
  {"op": "set_text", "value": ""},
  {"op": "focus_editor"},
  {"op": "text", "value": "(m"},
  {"op": "key", "value": "Ctrl+Space"},
  {"op": "assert_completion", "value": "mapcar"},
  {"op": "key", "value": "Escape"},
  {"op": "quit"}
]
