[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "assert_tabs", "value": 0},

  {"op": "log", "value": "New File (Alt+Insert)"},
  {"op": "key", "value": "Alt+Insert"},
  {"op": "assert_popup", "value": "new_file"},
  {"op": "text", "value": "util"},
  {"op": "key", "value": "Enter"},
  {"op": "assert_popup", "value": "none"},
  {"op": "assert_active_file", "value": "util.lisp"},
  {"op": "assert_tabs", "value": 1},

  {"op": "log", "value": "typing, saving with Ctrl+S"},
  {"op": "focus_editor"},
  {"op": "text", "value": "(defun util-fn ())"},
  {"op": "assert_modified", "value": true},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "assert_modified", "value": false},
  {"op": "assert_file_contains", "path": "${PROJ}/util.lisp", "value": "(defun util-fn ())"},

  {"op": "log", "value": "tabs: several files, switching, closing"},
  {"op": "open", "path": "${PROJ}/src/nav.lisp"},
  {"op": "open", "path": "${PROJ}/src/hello.lisp"},
  {"op": "assert_tabs", "value": 3},
  {"op": "key", "value": "Alt+Left"},
  {"op": "assert_active_file", "value": "nav.lisp"},
  {"op": "key", "value": "Alt+Right"},
  {"op": "assert_active_file", "value": "hello.lisp"},
  {"op": "key", "value": "Ctrl+F4"},
  {"op": "assert_tabs", "value": 2},

  {"op": "log", "value": "closing a modified tab asks for confirmation"},
  {"op": "focus_editor"},
  {"op": "text", "value": "x"},
  {"op": "key", "value": "Ctrl+F4"},
  {"op": "assert_popup", "value": "confirm"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_confirm.png"},
  {"op": "key", "value": "Escape"},
  {"op": "assert_popup", "value": "none"},
  {"op": "assert_tabs", "value": 2},

  {"op": "log", "value": "tool windows toggle"},
  {"op": "key", "value": "Alt+7"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_structure.png"},
  {"op": "key", "value": "Alt+1"},
  {"op": "key", "value": "Alt+6"},
  {"op": "assert_bottom", "value": "problems"},
  {"op": "key", "value": "Ctrl+Shift+F12"},
  {"op": "assert_bottom", "value": "none"},
  {"op": "quit"}
]
