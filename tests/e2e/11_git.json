[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "wait", "what": "git_ready", "timeout": 30},
  {"op": "assert_branch", "value": "main"},
  {"op": "assert_git_changes", "value": 0},

  {"op": "log", "value": "an edit shows up as a change with gutter markers"},
  {"op": "open", "path": "${PROJ}/src/nav.lisp"},
  {"op": "caret", "line": 3, "col": 1},
  {"op": "text", "value": "(defun gamma () 1)"},
  {"op": "key", "value": "Enter"},
  {"op": "assert_marks", "min": 1},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_dirty", "timeout": 30},
  {"op": "assert_git_changes", "value": 1},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_changes.png"},

  {"op": "log", "value": "git tool window"},
  {"op": "key", "value": "Alt+9"},
  {"op": "assert_bottom", "value": "git"},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_toolwindow.png"},

  {"op": "log", "value": "diff viewer is a tab of the editor area"},
  {"op": "focus_editor"},
  {"op": "command", "value": "git.diff"},
  {"op": "frames", "value": 4},
  {"op": "assert_diff", "file": "src/nav.lisp", "hunks": 1},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_diff.png"},

  {"op": "log", "value": "commit window: Ctrl+K focuses the message, Ctrl+Enter commits"},
  {"op": "key", "value": "Ctrl+K"},
  {"op": "assert_left", "value": "commit"},
  {"op": "frames", "value": 3},
  {"op": "text", "value": "add gamma function"},
  {"op": "frames", "value": 20},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_commit.png"},
  {"op": "key", "value": "Ctrl+Enter"},
  {"op": "assert_popup", "value": "none"},
  {"op": "wait", "what": "git_clean", "timeout": 30},
  {"op": "assert_git_changes", "value": 0},
  {"op": "assert_git_log", "value": "add gamma function"},

  {"op": "log", "value": "new branch"},
  {"op": "command", "value": "git.new_branch"},
  {"op": "assert_popup", "value": "new_branch"},
  {"op": "text", "value": "feature-x"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "git_ready", "timeout": 30},
  {"op": "frames", "value": 10},
  {"op": "assert_branch", "value": "feature-x"},

  {"op": "log", "value": "branch chooser"},
  {"op": "key", "value": "Ctrl+Shift+Backtick"},
  {"op": "assert_popup", "value": "palette"},
  {"op": "text", "value": "main"},
  {"op": "frames", "value": 3},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "git_ready", "timeout": 30},
  {"op": "frames", "value": 10},
  {"op": "assert_branch", "value": "main"},
  {"op": "quit"}
]
