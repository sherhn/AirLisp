[
  {"op": "log", "value": "@no_git: the project is not a git repository"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "frames", "value": 10},
  {"op": "assert_branch", "value": ""},
  {"op": "assert_git_changes", "value": 0},

  {"op": "open", "path": "${PROJ}/src/nav.lisp"},
  {"op": "key", "value": "Alt+9"},
  {"op": "frames", "value": 6},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_empty_state.png"},

  {"op": "log", "value": "a local commit works without git and becomes the base"},
  {"op": "focus_editor"},
  {"op": "key", "value": "Ctrl+Alt+K"},
  {"op": "assert_popup", "value": "local_commit"},
  {"op": "frames", "value": 3},
  {"op": "text", "value": "baseline"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "frames", "value": 6},
  {"op": "assert_base", "value": "local"},
  {"op": "assert_local_commits", "value": 1},
  {"op": "assert_git_changes", "value": 0},

  {"op": "focus_editor"},
  {"op": "caret", "line": 1, "col": 1},
  {"op": "text", "value": ";; after baseline"},
  {"op": "key", "value": "Enter"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_dirty", "timeout": 30},
  {"op": "assert_git_changes", "value": 1},
  {"op": "assert_marks", "exact": 1},
  {"op": "frames", "value": 6},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_changes.png"},

  {"op": "log", "value": "diff viewer compares with the checkpoint"},
  {"op": "command", "value": "git.diff"},
  {"op": "frames", "value": 4},
  {"op": "assert_popup", "value": "none"},
  {"op": "quit"}
]
