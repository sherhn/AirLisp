[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},

  {"op": "log", "value": "help lists the script commands"},
  {"op": "key", "value": "Alt+F12"},
  {"op": "assert_bottom", "value": "terminal"},
  {"op": "frames", "value": 4},
  {"op": "text", "value": "help"},
  {"op": "key", "value": "Enter"},
  {"op": "frames", "value": 3},
  {"op": "assert_term_contains", "value": "run <file>"},
  {"op": "text", "value": "scripts"},
  {"op": "key", "value": "Enter"},
  {"op": "frames", "value": 3},
  {"op": "assert_term_contains", "value": "run scripts/demo.als"},

  {"op": "log", "value": "a script runs its commands in order, keeps cd, honours - and @"},
  {"op": "text", "value": "run scripts/demo.als"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "script_done", "timeout": 60},
  {"op": "frames", "value": 3},
  {"op": "assert_term_contains", "value": "step-one"},
  {"op": "assert_term_contains", "value": "in-src"},
  {"op": "assert_term_contains", "value": "after-ignored"},
  {"op": "assert_term_contains", "value": "finished (6 commands)"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_script_ok.png"},

  {"op": "log", "value": "a failing command stops the script"},
  {"op": "command", "value": "repl.clear"},
  {"op": "text", "value": "run ../scripts/fail.als"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "script_done", "timeout": 60},
  {"op": "frames", "value": 3},
  {"op": "assert_term_contains", "value": "before-failure"},
  {"op": "assert_term_contains", "value": "stopped"},
  {"op": "assert_no_term_contains", "value": "must-not-run"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_script_failed.png"},
  {"op": "quit"}
]
