[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "open", "path": "${PROJ}/src/nav.lisp"},
  {"op": "wait", "what": "index"},
  {"op": "wait", "what": "git_ready", "timeout": 30},
  {"op": "language", "value": "ru"},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_main.png"},

  {"op": "log", "value": "messages and the terminal follow the language"},
  {"op": "key", "value": "Alt+F12"},
  {"op": "frames", "value": 4},
  {"op": "text", "value": "help"},
  {"op": "key", "value": "Enter"},
  {"op": "frames", "value": 3},
  {"op": "assert_term_contains", "value": "Команды терминала"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_terminal.png"},

  {"op": "log", "value": "dialogs"},
  {"op": "key", "value": "Ctrl+Alt+S"},
  {"op": "frames", "value": 5},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_settings.png"},
  {"op": "key", "value": "Escape"},
  {"op": "key", "value": "Ctrl+Shift+A"},
  {"op": "frames", "value": 5},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_palette.png"},
  {"op": "key", "value": "Escape"},

  {"op": "log", "value": "local commit browser"},
  {"op": "focus_editor"},
  {"op": "set_text", "value": "(defun alpha (x)\\n  (* x 9))\\n"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_dirty", "timeout": 30},
  {"op": "key", "value": "Ctrl+Alt+K"},
  {"op": "frames", "value": 3},
  {"op": "text", "value": "первый снимок"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "open_local_commit", "value": 1},
  {"op": "frames", "value": 5},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_local_view.png"},
  {"op": "key", "value": "Escape"},
  {"op": "language", "value": "en"},
  {"op": "quit"}
]
