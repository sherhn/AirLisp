[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "wait", "what": "git_ready", "timeout": 30},

  {"op": "log", "value": "split right shows the current file in both panes"},
  {"op": "open", "path": "${PROJ}/src/nav.lisp"},
  {"op": "open", "path": "${PROJ}/src/messy.lisp"},
  {"op": "open", "path": "${PROJ}/src/nav.lisp"},
  {"op": "assert_split", "value": "none"},
  {"op": "command", "value": "view.split_right"},
  {"op": "frames", "value": 4},
  {"op": "assert_split", "value": "vertical", "focus": "second", "other": "nav.lisp"},
  {"op": "assert_active_file", "value": "nav.lisp"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_split_same.png"},

  {"op": "log", "value": "opening another file fills only the focused pane"},
  {"op": "open", "path": "${PROJ}/src/messy.lisp"},
  {"op": "frames", "value": 4},
  {"op": "assert_active_file", "value": "messy.lisp"},
  {"op": "assert_split", "value": "vertical", "focus": "second", "other": "nav.lisp"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_split_two_files.png"},

  {"op": "log", "value": "typing goes to the focused pane, a click moves the focus"},
  {"op": "focus_editor"},
  {"op": "caret", "line": 1, "col": 1},
  {"op": "text", "value": ";; right pane"},
  {"op": "key", "value": "Enter"},
  {"op": "assert_modified", "value": true},
  {"op": "assert_text_contains", "value": ";; right pane"},
  {"op": "pane_click", "pane": 1},
  {"op": "frames", "value": 4},
  {"op": "assert_split", "value": "vertical", "focus": "first", "other": "messy.lisp"},
  {"op": "assert_active_file", "value": "nav.lisp"},
  {"op": "caret", "line": 1, "col": 1},
  {"op": "text", "value": ";; left pane"},
  {"op": "key", "value": "Enter"},
  {"op": "assert_text_contains", "value": ";; left pane"},
  {"op": "pane_click", "pane": 2},
  {"op": "frames", "value": 4},
  {"op": "assert_active_file", "value": "messy.lisp"},
  {"op": "assert_text_contains", "value": ";; right pane"},

  {"op": "log", "value": "the tab of the other pane moves the focus there"},
  {"op": "command", "value": "view.switch_pane"},
  {"op": "assert_active_file", "value": "nav.lisp"},
  {"op": "command", "value": "view.switch_pane"},
  {"op": "assert_active_file", "value": "messy.lisp"},

  {"op": "log", "value": "stacked panes"},
  {"op": "command", "value": "view.split_down"},
  {"op": "frames", "value": 4},
  {"op": "assert_split", "value": "horizontal", "focus": "second"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_split_down.png"},

  {"op": "log", "value": "unsplit"},
  {"op": "command", "value": "view.unsplit"},
  {"op": "frames", "value": 3},
  {"op": "assert_split", "value": "none"},
  {"op": "assert_tabs", "value": 2},

  {"op": "log", "value": "diff on the left, the file to edit on the right; the diff follows the typing"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_dirty", "timeout": 30},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "key", "value": "Alt+0"},
  {"op": "frames", "value": 4},
  {"op": "commit_click", "value": "src/messy.lisp"},
  {"op": "frames", "value": 4},
  {"op": "assert_diff", "file": "src/messy.lisp", "hunks": 1},
  {"op": "diff_edit_beside"},
  {"op": "frames", "value": 5},
  {"op": "assert_split", "value": "vertical", "focus": "second"},
  {"op": "assert_active_file", "value": "messy.lisp"},
  {"op": "focus_editor"},
  {"op": "caret", "line": 1, "col": 1},
  {"op": "text", "value": ";; typed while the diff is open"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "diff_new_contains", "value": ";; typed while the diff is open", "timeout": 10},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_edit_beside.png"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "quit"}
]
