[
  {"op": "log", "value": "@long_file: gutter, code overview and scrollbar ruler on a long file with a few changes"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "open", "path": "${PROJ}/src/long.lisp"},
  {"op": "wait", "what": "index"},
  {"op": "wait", "what": "git_ready", "timeout": 30},
  {"op": "caret", "line": 12, "col": 1},
  {"op": "text", "value": ";; changed near the top"},
  {"op": "key", "value": "Enter"},
  {"op": "caret", "line": 300, "col": 3},
  {"op": "text", "value": "(print :edited) "},
  {"op": "caret", "line": 420, "col": 1},
  {"op": "text", "value": ";; another change"},
  {"op": "key", "value": "Enter"},
  {"op": "caret", "line": 290, "col": 1},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "frames", "value": 6},
  {"op": "assert_marks", "min": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_dark.png"},
  {"op": "command", "value": "view.toggle_theme"},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_light.png"},
  {"op": "command", "value": "view.toggle_theme"},
  {"op": "quit"}
]
