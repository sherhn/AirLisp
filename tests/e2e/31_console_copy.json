[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},

  {"op": "log", "value": "the terminal shows a few lines to select from"},
  {"op": "key", "value": "Alt+F12"},
  {"op": "assert_bottom", "value": "terminal"},
  {"op": "frames", "value": 4},
  {"op": "text", "value": "echo alpha-beta gamma"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "term_idle", "timeout": 30},
  {"op": "text", "value": "echo second-line"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "term_idle", "timeout": 30},
  {"op": "wait", "what": "term_contains", "value": "second-line", "timeout": 30},
  {"op": "frames", "value": 4},

  {"op": "log", "value": "drag over one line: that part is copied"},
  {"op": "log_mouse", "action": "down", "line": "alpha-beta gamma", "col": 6},
  {"op": "frames", "value": 2},
  {"op": "log_mouse", "action": "move", "line": "alpha-beta gamma", "col": "end"},
  {"op": "frames", "value": 2},
  {"op": "log_mouse", "action": "up", "line": "alpha-beta gamma", "col": "end"},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_selected_word.png"},
  {"op": "copy"},
  {"op": "frames", "value": 2},
  {"op": "assert_copied", "value": "beta gamma"},

  {"op": "log", "value": "drag over several lines: the lines are joined, the prompt included"},
  {"op": "log_mouse", "action": "down", "line": "alpha-beta gamma", "col": 0},
  {"op": "frames", "value": 2},
  {"op": "log_mouse", "action": "move", "line": "second-line", "col": "end"},
  {"op": "frames", "value": 2},
  {"op": "log_mouse", "action": "up", "line": "second-line", "col": "end"},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_selected_lines.png"},
  {"op": "copy"},
  {"op": "frames", "value": 2},
  {"op": "assert_copied", "starts": "alpha-beta gamma\n$ ", "ends": "> echo second-line\nsecond-line"},

  {"op": "log", "value": "double click a word, triple click a line"},
  {"op": "log_mouse", "action": "click", "line": "alpha-beta gamma", "col": 3, "count": 2},
  {"op": "frames", "value": 3},
  {"op": "copy"},
  {"op": "frames", "value": 2},
  {"op": "assert_copied", "value": "alpha-beta"},
  {"op": "frames", "value": 30},
  {"op": "log_mouse", "action": "click", "line": "second-line", "col": 3, "count": 3},
  {"op": "frames", "value": 3},
  {"op": "copy"},
  {"op": "frames", "value": 2},
  {"op": "assert_copied", "value": "second-line"},

  {"op": "log", "value": "Ctrl+A selects the whole log (once the log has the keys: after a click in it)"},
  {"op": "log_mouse", "action": "click", "line": "second-line", "col": 0},
  {"op": "frames", "value": 3},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "frames", "value": 3},
  {"op": "copy"},
  {"op": "frames", "value": 2},
  {"op": "assert_copied", "starts": "Terminal - commands run in your system shell.", "contains": "\nalpha-beta gamma\n$ ", "ends": "> echo second-line\nsecond-line"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_selected_all.png"},

  {"op": "log", "value": "after copying the command line has the keys again"},
  {"op": "text", "value": "echo typed-after-copy"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "term_contains", "value": "typed-after-copy", "timeout": 30},
  {"op": "quit"}
]
