[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},

  {"op": "log", "value": "a long log in the terminal, scrolled to its end"},
  {"op": "key", "value": "Alt+F12"},
  {"op": "assert_bottom", "value": "terminal"},
  {"op": "frames", "value": 4},
  {"op": "term_fill", "value": 150},
  {"op": "frames", "value": 8},
  {"op": "assert_log", "at_bottom": true},

  {"op": "log", "value": "select from the last line upwards and keep the mouse above the log: it scrolls up and the selection grows"},
  {"op": "log_mouse", "action": "down", "line": "@last", "col": "end"},
  {"op": "frames", "value": 2},
  {"op": "log_mouse", "action": "move", "line": "@last", "col": 0, "y": "above", "px": 80},
  {"op": "sleep", "value": 1.2},
  {"op": "assert_log", "scrolled_up_at_least": 400, "at_bottom": false},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_scrolled_up.png"},
  {"op": "log_mouse", "action": "up", "line": "@last", "col": 0, "y": "above", "px": 80},
  {"op": "frames", "value": 3},
  {"op": "copy"},
  {"op": "frames", "value": 2},
  {"op": "assert_copied", "ends": "line 150", "min_lines": 15},

  {"op": "log", "value": "and the other way: from the top row, mouse below the log - it scrolls back down"},
  {"op": "log_mouse", "action": "down", "line": "@first", "col": 0},
  {"op": "frames", "value": 2},
  {"op": "log_mouse", "action": "move", "line": "@first", "col": 0, "y": "below", "px": 80},
  {"op": "sleep", "value": 2.5},
  {"op": "assert_log", "at_bottom": true},
  {"op": "log_mouse", "action": "up", "line": "@last", "col": 0, "y": "below", "px": 80},
  {"op": "frames", "value": 3},
  {"op": "copy"},
  {"op": "frames", "value": 2},
  {"op": "assert_copied", "min_lines": 15},
  {"op": "log", "value": "dragging out of the window: egui loses the pointer, the scrolling goes on"},
  {"op": "log_mouse", "action": "down", "line": "@last", "col": "end"},
  {"op": "frames", "value": 2},
  {"op": "log_mouse", "action": "move", "line": "@last", "col": 0, "y": "above", "px": 40},
  {"op": "frames", "value": 3},
  {"op": "pointer_gone"},
  {"op": "sleep", "value": 1.2},
  {"op": "assert_log", "scrolled_up_at_least": 400},
  {"op": "log_mouse", "action": "up", "line": "@last", "col": 0, "y": "above", "px": 40},
  {"op": "frames", "value": 3},

  {"op": "quit"}
]
