[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "open", "path": "${PROJ}/src/scratch.lisp"},
  {"op": "wait", "what": "index"},
  {"op": "log", "value": "the line endings of a file can be switched in the editor, and the next save writes them"},
  {"op": "set_text", "value": "(a)\\nb\\n"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "wait", "what": "all_saved", "timeout": 10},
  {"op": "assert_eol", "value": "LF"},
  {"op": "assert_eol", "value": "LF", "file": true, "path": "${PROJ}/src/scratch.lisp"},
  {"op": "command", "value": "edit.eol_crlf"},
  {"op": "frames", "value": 2},
  {"op": "assert_eol", "value": "CRLF"},
  {"op": "assert_modified", "value": true},
  {"op": "assert_text", "value": "(a)\\nb\\n"},
  {"op": "assert_eol", "value": "LF", "file": true, "path": "${PROJ}/src/scratch.lisp"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "wait", "what": "all_saved", "timeout": 10},
  {"op": "assert_modified", "value": false},
  {"op": "assert_eol", "value": "CRLF", "file": true, "path": "${PROJ}/src/scratch.lisp"},
  {"op": "log", "value": "typing keeps the endings; switching back and saving gives LF again"},
  {"op": "text", "value": "x"},
  {"op": "key", "value": "Enter"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "wait", "what": "all_saved", "timeout": 10},
  {"op": "assert_eol", "value": "CRLF", "file": true, "path": "${PROJ}/src/scratch.lisp"},
  {"op": "command", "value": "edit.eol_lf"},
  {"op": "assert_modified", "value": true},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "wait", "what": "all_saved", "timeout": 10},
  {"op": "assert_eol", "value": "LF"},
  {"op": "assert_eol", "value": "LF", "file": true, "path": "${PROJ}/src/scratch.lisp"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}.png"},
  {"op": "quit"}
]
